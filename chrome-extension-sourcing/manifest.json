{
  "manifest_version": 3,
  "name": "App Sourcing - Importateur 1-Clic & M\u00e9dias",
  "version": "1.2.0",
  "description": "Importez vos produits Alibaba, 1688, Taobao en 1 clic vers votre application Sourcing.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "contextMenus",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://192.168.*/*",
        "https://*.netlify.app/*",
        "*://*/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Importer ce produit dans App Sourcing"
  }
}